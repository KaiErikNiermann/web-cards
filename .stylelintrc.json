{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-declaration-strict-value",
    "stylelint-order"
  ],
  "rules": {
    "import-notation": "string",
    "scale-unlimited/declaration-strict-value": [
      [
        "/color$/",
        "fill",
        "stroke",
        "z-index",
        "font-size",
        "line-height",
        "/^padding/",
        "/^margin/",
        "/gap$/",
        "/^border-radius/",
        "transition-duration",
        "animation-duration",
        "box-shadow"
      ],
      {
        "ignoreValues": [
          "currentColor",
          "transparent",
          "inherit",
          "initial",
          "unset",
          "revert",
          "none",
          "auto",
          "0",
          "1px",
          "100%"
        ],
        "disableFix": true,
        "message": "PC-1: use a design token (var(--\u2026)), not a literal"
      }
    ],
    "declaration-no-important": true,
    "selector-max-compound-selectors": 2,
    "selector-max-id": 0,
    "no-descending-specificity": true,
    "custom-property-pattern": [
      "^_?[a-z][a-z0-9]*(--?[a-z0-9]+)*$",
      {
        "message": "kebab-case; a double dash is Tailwind's sub-token separator (--text-sm--line-height)"
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "custom-variant",
          "source",
          "reference",
          "apply",
          "variant",
          "config",
          "plugin",
          "slot",
          "property",
          "container",
          "starting-style",
          "scope",
          "layer",
          "supports"
        ]
      }
    ],
    "order/properties-order": [
      [
        "container",
        "container-type",
        "display",
        "grid-template-columns",
        "grid-auto-flow",
        "flex-direction",
        "flex-wrap",
        "place-items",
        "place-content",
        "align-items",
        "justify-content",
        "gap"
      ],
      {
        "unspecified": "bottomAlphabetical"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/tokens.css",
        "**/theme.css",
        "**/app.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": null
      }
    }
  ]
}
